# Push-everything mode (operator decision). Only OS/tooling noise is ignored.
.DS_Store
Thumbs.db

# Watcher runtime state: per-clone cursors, logs, PID file, and the merged event
# stream. Regenerated by agents/watch_*.py on each machine; not a shared artifact.
.shared/events/

# Python bytecode (build artifacts, never shared).
__pycache__/
*.pyc

# Local Hedgehog handoff transport; copied artifacts are uploaded separately.
WOLVERINE_OUTBOX/

# Local Codex scheduled-run cache; reproducible artifacts belong in evidence/.
hedgehog/.agent_cache/
