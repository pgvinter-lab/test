{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pgvinter-lab/test/hedgehog/evidence/schema.json",
  "title": "Hedgehog Engineering Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "task_id",
    "title",
    "status",
    "generated_at",
    "producer",
    "commands",
    "checks",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "minLength": 3},
    "task_id": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["pass", "fail", "partial", "blocked"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 2},
    "environment": {"type": "object"},
    "commands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["pass", "fail", "skipped"]},
          "details": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "hash_mode"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "hash_mode": {"enum": ["raw", "lf-normalized"]}
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}