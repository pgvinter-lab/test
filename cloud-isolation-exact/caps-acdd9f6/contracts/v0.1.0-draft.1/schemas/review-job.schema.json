{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/review-job.schema.json",
  "title": "Bridge 2.0 Draft Review Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "projectId",
    "mode",
    "status",
    "requestedBy",
    "requiredRole",
    "independence",
    "target",
    "attempt",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-draft.1" },
    "jobId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
    },
    "projectId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
    },
    "mode": { "enum": ["collaboration", "independent_review"] },
    "status": {
      "enum": [
        "queued",
        "claimable",
        "claimed",
        "running",
        "awaiting_input",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "requestedBy": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/principalRef"
    },
    "requiredRole": { "enum": ["collaborator", "reviewer", "worker"] },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "excludedPrincipalIds",
        "provenanceArtifactIds",
        "evaluatedBy",
        "evaluatedAt"
      ],
      "properties": {
        "policy": { "enum": ["required", "not_required", "waived_by_owner"] },
        "excludedPrincipalIds": {
          "type": "array",
          "items": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "provenanceArtifactIds": {
          "type": "array",
          "items": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "evaluatedBy": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/principalRef"
        },
        "evaluatedAt": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/timestamp"
        },
        "waiverReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "waiverApprovalArtifactId": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "policy": { "const": "waived_by_owner" } } },
          "then": {
            "properties": {
              "waiverReason": true,
              "waiverApprovalArtifactId": true
            },
            "required": ["waiverReason", "waiverApprovalArtifactId"]
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "artifactIds",
        "instructions",
        "acceptanceCriteria"
      ],
      "properties": {
        "contractVersion": { "const": "0.1.0-draft.1" },
        "artifactIds": {
          "type": "array",
          "minItems": 1,
          "minItems": 1,
          "items": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "attempt": { "type": "integer", "minimum": 0 },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "claimedBy",
        "generation",
        "fencingToken",
        "idempotencyKey",
        "claimedAt",
        "leaseExpiresAt"
      ],
      "properties": {
        "claimId": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
        },
        "claimedBy": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/principalRef"
        },
        "generation": { "type": "integer", "minimum": 1 },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "idempotencyKey": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
        },
        "claimedAt": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/timestamp"
        },
        "leaseExpiresAt": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/timestamp"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "artifactIds", "disagreements"],
      "properties": {
        "outcome": {
          "enum": ["accepted", "changes_requested", "rejected", "inconclusive"]
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "disagreements": {
          "type": "array",
          "items": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/disagreement"
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "retryable"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "retryable": { "type": "boolean" }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "by"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "by": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/principalRef"
        }
      }
    },
    "createdAt": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.1/schemas/common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "independent_review" } } },
      "then": {
        "properties": {
          "requiredRole": { "const": "reviewer" },
          "independence": {
            "type": "object",
            "properties": {
              "policy": { "enum": ["required", "waived_by_owner"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["claimed", "running", "awaiting_input", "completed", "failed"]
          }
        }
      },
      "then": {
        "properties": { "claim": true },
        "required": ["claim"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": {
        "properties": { "result": true },
        "required": ["result"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "properties": { "failure": true },
        "required": ["failure"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "cancelled" } } },
      "then": {
        "properties": { "cancellation": true },
        "required": ["cancellation"]
      }
    }
  ]
}
