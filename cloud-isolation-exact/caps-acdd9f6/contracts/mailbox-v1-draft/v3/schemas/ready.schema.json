{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/contracts/mailbox-v1-draft/v3/schemas/ready.schema.json",
  "title": "Bridge Mailbox v3 Ready Marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "objectKind", "objectId", "sha256", "byteLength", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "bridge-mailbox-v3" },
    "kind": { "const": "ready" },
    "objectKind": { "enum": ["message", "response"] },
    "objectId": { "$ref": "common.schema.json#/$defs/identifier" },
    "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "byteLength": { "type": "integer", "minimum": 1, "maximum": 2097152 },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
