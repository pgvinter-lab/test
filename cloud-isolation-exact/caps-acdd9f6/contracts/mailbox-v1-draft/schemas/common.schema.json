{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/contracts/mailbox-v1-draft/schemas/common.schema.json",
  "title": "Bridge Mailbox Draft Common Definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": { "enum": ["chatgpt", "gemini"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "sessionId", "hostId"],
      "properties": {
        "principalId": { "$ref": "#/$defs/identifier" },
        "sessionId": { "$ref": "#/$defs/identifier" },
        "hostId": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
