{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/key-capsule.schema.json",
  "title": "Bridge 2.0 Recovery Key Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "capsuleId",
    "backupId",
    "keyRef",
    "wrappingAlgorithmId",
    "oaepHash",
    "recipientKeyFingerprint",
    "dataKeySha256",
    "wrappedKeyBase64",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "bridge2-key-capsule-v1" },
    "contractVersion": { "const": "0.1.0-draft.4" },
    "capsuleId": {
      "type": "string",
      "pattern": "^capsule\\.[A-Za-z0-9._:-]+$",
      "maxLength": 200
    },
    "backupId": {
      "type": "string",
      "pattern": "^backup\\.[A-Za-z0-9._:-]+$",
      "maxLength": 200
    },
    "keyRef": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 300
    },
    "wrappingAlgorithmId": { "const": "rsa-oaep-sha256" },
    "oaepHash": { "const": "sha256" },
    "recipientKeyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dataKeySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "wrappedKeyBase64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 4096
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
