{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/restore-manifest.schema.json",
  "title": "Bridge 2.0 Draft Restore Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "restoreId",
    "backupId",
    "projectId",
    "mode",
    "requestedAt",
    "requestedBy",
    "targetHostId",
    "expectedSourceGeneration",
    "takeover",
    "preconditions",
    "steps",
    "validation",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-draft.2" },
    "restoreId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/common.schema.json#/$defs/identifier"
    },
    "backupId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/common.schema.json#/$defs/identifier"
    },
    "projectId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/common.schema.json#/$defs/identifier"
    },
    "mode": { "enum": ["new_host", "replace_local", "recovery_drill"] },
    "requestedAt": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/common.schema.json#/$defs/timestamp"
    },
    "requestedBy": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/common.schema.json#/$defs/principalRef"
    },
    "targetHostId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/common.schema.json#/$defs/identifier"
    },
    "expectedSourceGeneration": { "type": "integer", "minimum": 1 },
    "takeover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "newGeneration"],
      "properties": {
        "mode": { "enum": ["no_takeover", "owner_confirmed_takeover"] },
        "newGeneration": { "type": "integer", "minimum": 1 },
        "approvalRef": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "owner_confirmed_takeover" } } },
          "then": {
            "properties": { "approvalRef": true },
            "required": ["approvalRef"]
          }
        }
      ]
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status"],
        "properties": {
          "check": { "type": "string", "minLength": 1, "maxLength": 300 },
          "status": { "enum": ["pending", "passed", "failed", "waived"] },
          "detail": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "operation", "status"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "operation": {
            "enum": ["verify_backup", "restore_source", "restore_state", "migrate", "doctor", "activate"]
          },
          "status": { "enum": ["pending", "running", "passed", "failed", "skipped"] },
          "expectedSha256": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.2/schemas/common.schema.json#/$defs/sha256"
          },
          "detail": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractTests", "doctor", "eventSequence"],
      "properties": {
        "contractTests": { "enum": ["pending", "passed", "failed"] },
        "doctor": { "enum": ["pending", "passed", "failed"] },
        "eventSequence": { "type": "integer", "minimum": 0 }
      }
    },
    "status": { "enum": ["planned", "running", "completed", "failed", "cancelled"] }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "recovery_drill" } } },
      "then": {
        "properties": {
          "takeover": {
            "type": "object",
            "properties": { "mode": { "const": "no_takeover" } }
          },
          "steps": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": { "operation": { "const": "activate" } },
                "required": ["operation"]
              }
            }
          }
        }
      }
    }
  ]
}
