{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.3/schemas/adapter.schema.json",
  "title": "Bridge 2.0 Draft Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapterId",
    "adapterVersion",
    "interfaceVersion",
    "displayName",
    "kind",
    "operations",
    "capabilities",
    "transports",
    "security",
    "health"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-draft.3" },
    "adapterId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.3/schemas/common.schema.json#/$defs/identifier"
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "interfaceVersion": { "const": "0.1.0-draft.3" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": { "enum": ["browser", "api", "cli", "local_process", "storage"] },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inputSchema",
          "outputSchema",
          "idempotent",
          "sideEffectClass",
          "timeoutMs"
        ],
        "properties": {
          "inputSchema": { "type": "string", "format": "uri-reference" },
          "outputSchema": { "type": "string", "format": "uri-reference" },
          "idempotent": { "type": "boolean" },
          "sideEffectClass": {
            "enum": ["read_only", "local_write", "external_reversible", "external_irreversible"]
          },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["in_process", "stdio", "remote_http"] }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialMode",
        "networkAccess",
        "sensitiveData",
        "humanApprovalFor",
        "approvalPolicy"
      ],
      "properties": {
        "credentialMode": {
          "enum": ["none", "environment_reference", "os_keychain_reference", "brokered"]
        },
        "networkAccess": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" },
          "uniqueItems": true
        },
        "sensitiveData": {
          "enum": ["forbidden", "local_only", "approved_external_only", "supported"]
        },
        "humanApprovalFor": {
          "type": "array",
          "minItems": 2,
          "allOf": [
            { "contains": { "const": "external_irreversible" } },
            { "contains": { "const": "sensitive_external" } }
          ],
          "items": {
            "enum": [
              "external_reversible",
              "external_irreversible",
              "sensitive_external",
              "credential_change"
            ]
          },
          "uniqueItems": true
        },
        "approvalPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultDecision",
            "preapproval",
            "scopeExpansionDecision",
            "grantSchema"
          ],
          "properties": {
            "defaultDecision": { "const": "ask" },
            "preapproval": { "enum": ["disabled", "bounded_grants"] },
            "scopeExpansionDecision": { "const": "ask" },
            "grantSchema": {
              "const": "https://bridge2.local/contracts/v0.1.0-draft.3/schemas/approval-grant.schema.json"
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkOperation", "states"],
      "properties": {
        "checkOperation": { "type": "string", "minLength": 1, "maxLength": 100 },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ready", "degraded", "blocked", "offline"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "browser" } } },
      "then": {
        "properties": {
          "transports": {
            "type": "array",
            "not": { "contains": { "const": "in_process" } }
          },
          "security": {
            "type": "object",
            "properties": {
              "approvalPolicy": {
                "type": "object",
                "properties": { "preapproval": { "const": "bounded_grants" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "security": {
            "type": "object",
            "properties": {
              "credentialMode": { "not": { "const": "none" } }
            },
            "required": ["credentialMode"]
          }
        }
      },
      "then": {
        "properties": {
          "transports": {
            "type": "array",
            "not": { "contains": { "const": "in_process" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "enum": ["browser", "api"] } } },
      "then": {
        "properties": {
          "security": {
            "type": "object",
            "properties": {
              "networkAccess": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
