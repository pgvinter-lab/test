{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.3/schemas/migration.schema.json",
  "title": "Bridge 2.0 Draft Migration Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "migrationId",
    "fromVersion",
    "toVersion",
    "checksum",
    "backupRequired",
    "estimatedDowntimeSeconds",
    "rollbackClass",
    "preconditions",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-draft.3" },
    "migrationId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.3/schemas/common.schema.json#/$defs/identifier"
    },
    "fromVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "toVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "checksum": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.3/schemas/common.schema.json#/$defs/sha256"
    },
    "backupRequired": { "const": true },
    "estimatedDowntimeSeconds": { "type": "integer", "minimum": 0 },
    "rollbackClass": { "enum": ["restore_only", "reversible"] },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apply", "verify"],
      "properties": {
        "apply": { "type": "string", "minLength": 1, "maxLength": 300 },
        "verify": { "type": "string", "minLength": 1, "maxLength": 300 },
        "rollback": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "rollbackClass": { "const": "reversible" } } },
      "then": {
        "properties": {
          "operations": {
            "type": "object",
            "properties": { "rollback": true },
            "required": ["rollback"]
          }
        }
      }
    }
  ]
}
