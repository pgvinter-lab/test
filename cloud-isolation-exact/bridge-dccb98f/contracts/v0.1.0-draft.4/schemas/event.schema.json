{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/event.schema.json",
  "title": "Bridge 2.0 Draft Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "sequence",
    "generation",
    "eventType",
    "aggregate",
    "actor",
    "occurredAt",
    "correlationId",
    "data",
    "hashAlgorithm",
    "hash"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-draft.4" },
    "eventId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "projectId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "eventType": {
      "enum": [
        "review_job.created",
        "review_job.claimable",
        "review_job.claimed",
        "review_job.started",
        "review_job.input_requested",
        "review_job.input_resumed",
        "review_job.completed",
        "review_job.failed",
        "review_job.cancelled",
        "review_job.claim_expired",
        "review_job.instructions_amended",
        "approval_grant.created",
        "approval_grant.revoked",
        "approval_grant.consumed",
        "approval_grant.exhausted",
        "browser.authorization_decided",
        "collaboration.command_recorded",
        "project.generation_advanced"
      ]
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": [
            "project",
            "review_job",
            "artifact",
            "adapter",
            "adapter_action",
            "approval_grant",
            "backup",
            "restore"
          ]
        },
        "id": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
        }
      }
    },
    "actor": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/principalRef"
    },
    "occurredAt": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "causationId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "idempotencyKey": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "data": {
      "type": "object",
      "description": "Closed by eventType below. Source bytes, prompts, credentials, and arbitrary extension fields are forbidden."
    },
    "previousHash": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/sha256"
    },
    "hashAlgorithm": { "const": "sha256-bridge-cjson-v1" },
    "hash": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sequence": { "const": 1 } } },
      "then": {
        "not": {
          "properties": { "previousHash": true },
          "required": ["previousHash"]
        }
      }
    },
    {
      "if": { "properties": { "sequence": { "type": "integer", "minimum": 2 } } },
      "then": {
        "properties": { "previousHash": true },
        "required": ["previousHash"]
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.created" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "instructionSetId", "instructionVersion"],
            "properties": {
              "mode": { "enum": ["collaboration", "independent_review"] },
              "instructionSetId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "instructionVersion": { "type": "integer", "minimum": 1 },
              "approvalPolicyOverride": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/approvalPolicyOverride"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.claimable" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/emptyData" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.claimed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "fencingToken"],
            "properties": {
              "claimId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "fencingToken": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.started" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/emptyData" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.input_requested" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.input_resumed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/emptyData" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.completed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "artifactIds", "disagreements", "citations"],
            "properties": {
              "outcome": {
                "enum": ["accepted", "changes_requested", "rejected", "inconclusive"]
              },
              "artifactIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
                },
                "uniqueItems": true
              },
              "disagreements": {
                "type": "array",
                "items": {
                  "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/disagreement"
                }
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/artifact.schema.json#/$defs/citation"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.failed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "retryable"],
            "properties": {
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "retryable": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.cancelled" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.claim_expired" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/emptyData" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_job.instructions_amended" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instructionSetId",
              "fromVersion",
              "toVersion",
              "materialAmendment",
              "invalidatedApprovalGrantIds"
            ],
            "properties": {
              "instructionSetId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "fromVersion": { "type": "integer", "minimum": 1 },
              "toVersion": { "type": "integer", "minimum": 2 },
              "materialAmendment": { "type": "boolean" },
              "invalidatedApprovalGrantIds": {
                "type": "array",
                "items": {
                  "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
                },
                "uniqueItems": true
              },
              "approvalPolicyOverrideId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "overriddenRulesApplied": {
                "$ref": "#/$defs/overriddenRulesApplied"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "approval_grant.created" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grantId", "jobId", "actions", "expiresAt", "maxUses"],
            "properties": {
              "grantId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "jobId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 },
                "uniqueItems": true
              },
              "expiresAt": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/timestamp"
              },
              "maxUses": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "approval_grant.revoked" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grantId", "reason", "invalidatedByInstructionAmendment"],
            "properties": {
              "grantId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "invalidatedByInstructionAmendment": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "approval_grant.consumed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grantId", "actionId", "useNumber"],
            "properties": {
              "grantId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "actionId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "useNumber": { "type": "integer", "minimum": 1 },
              "approvalPolicyOverrideId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "overriddenRulesApplied": {
                "$ref": "#/$defs/overriddenRulesApplied"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "approval_grant.exhausted" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grantId", "usesConsumed"],
            "properties": {
              "grantId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "usesConsumed": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "browser.authorization_decided" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actionId",
              "jobId",
              "adapterId",
              "operation",
              "origin",
              "destination",
              "sideEffectClass",
              "decision",
              "reason"
            ],
            "properties": {
              "actionId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "jobId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "adapterId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "operation": { "type": "string", "minLength": 1, "maxLength": 200 },
              "origin": { "type": "string", "format": "uri-reference", "minLength": 1 },
              "destination": { "type": "string", "format": "uri-reference", "minLength": 1 },
              "sideEffectClass": {
                "enum": ["read_only", "local_write", "external_reversible", "external_irreversible"]
              },
              "decision": { "enum": ["allow", "ask", "deny"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "approvalGrantId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "approvalPolicyOverrideId": {
                "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
              },
              "overriddenRulesApplied": {
                "$ref": "#/$defs/overriddenRulesApplied"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "collaboration.command_recorded" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "agent", "request", "outcome"],
            "properties": {
              "operation": {
                "enum": [
                  "bridge_sync",
                  "bridge_claim",
                  "bridge_release",
                  "bridge_handoff",
                  "bridge_log",
                  "bridge_set_boss",
                  "bridge_reap",
                  "bridge_register_project",
                  "bridge_task_add",
                  "bridge_task_update",
                  "bridge_task_dispatch",
                  "bridge_a2a_send",
                  "bridge_backup",
                  "bridge_restore",
                  "legacy_import"
                ]
              },
              "agent": { "type": "string", "minLength": 1, "maxLength": 100 },
              "request": { "$ref": "#/$defs/legacyCommandRequest" },
              "outcome": { "$ref": "#/$defs/legacyCommandOutcome" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "project.generation_advanced" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "legacyCommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "projectPath": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "paths": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "uniqueItems": true
        },
        "note": { "type": "string", "maxLength": 16000 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "to": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
        "taskId": { "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier" },
        "target": { "enum": ["antigravity", "claude", "codex"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 300 },
        "promptSha256": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/sha256"
        },
        "promptBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "status": { "enum": ["todo", "doing", "done"] },
        "ttlMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 10080 },
        "idleMinutes": { "type": "number", "minimum": 0, "maximum": 10080 },
        "force": { "type": "boolean" },
        "destination": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "remote": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceHash": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/sha256"
        }
      }
    },
    "legacyCommandOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "firstSync": { "type": "boolean" },
        "openedNewSession": { "type": "boolean" },
        "control": { "type": ["string", "null"], "maxLength": 100 },
        "previousControl": { "type": ["string", "null"], "maxLength": 100 },
        "boss": { "type": "string", "minLength": 1, "maxLength": 100 },
        "granted": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "uniqueItems": true
        },
        "released": {
          "oneOf": [
            { "const": "all" },
            {
              "type": "array",
              "maxItems": 500,
              "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "uniqueItems": true
            }
          ]
        },
        "remaining": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "uniqueItems": true
        },
        "changedFiles": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "uniqueItems": true
        },
        "changedActivityIds": {
          "type": "array",
          "items": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "changedActivities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["activityId", "agent", "action", "files", "iso"],
            "properties": {
              "activityId": { "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier" },
              "agent": { "type": "string", "minLength": 1, "maxLength": 100 },
              "action": { "type": "string", "minLength": 1, "maxLength": 100 },
              "files": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
              },
              "note": { "type": "string", "maxLength": 16000 },
              "iso": { "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/timestamp" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested", "conflictsWith", "heldBy"],
            "properties": {
              "requested": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "conflictsWith": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "heldBy": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        },
        "hashes": {
          "type": "object",
          "propertyNames": { "minLength": 1, "maxLength": 2000 },
          "additionalProperties": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/sha256"
          }
        },
        "taskId": { "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier" },
        "taskTitle": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "taskStatus": { "enum": ["todo", "doing", "done"] },
        "taskOwner": { "type": ["string", "null"], "maxLength": 100 },
        "boardOnly": { "type": "boolean" },
        "dispatchState": { "const": "not_dispatched" },
        "dispatchReason": { "enum": ["board_entry_only", "control_token_only"] },
        "channel": { "const": "a2a" },
        "taskState": {
          "enum": ["submitted", "working", "input-required", "completed", "canceled", "failed", "rejected", "auth-required", "unknown"]
        },
        "terminal": { "type": "boolean" },
        "artifactIds": {
          "type": "array",
          "items": { "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier" },
          "uniqueItems": true
        },
        "a2aTaskId": { "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier" },
        "a2aState": {
          "enum": ["submitted", "working", "input-required", "completed", "canceled", "failed", "rejected", "auth-required", "unknown"]
        },
        "boardStatus": { "enum": ["todo", "doing", "done"] },
        "failure": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "taskCount": { "type": "integer", "minimum": 0 },
        "closedProjects": { "type": "integer", "minimum": 0 },
        "releasedLeases": { "type": "integer", "minimum": 0 },
        "expiredLeases": { "type": "integer", "minimum": 0 },
        "sessionImported": { "type": "boolean" },
        "controlImported": { "type": "boolean" },
        "bundle": { "type": "string", "minLength": 1, "maxLength": 2000 },
