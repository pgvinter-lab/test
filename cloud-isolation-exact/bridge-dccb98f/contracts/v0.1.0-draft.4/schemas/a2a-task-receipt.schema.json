{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/a2a-task-receipt.schema.json",
  "title": "Bridge A2A Terminal Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "taskId",
    "state",
    "terminal",
    "completed",
    "artifactIds",
    "output",
    "failure"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-draft.4" },
    "channel": { "const": "a2a" },
    "taskId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "state": {
      "enum": ["submitted", "working", "input-required", "completed", "canceled", "failed", "rejected", "auth-required", "unknown"]
    },
    "terminal": { "type": "boolean" },
    "completed": { "type": "boolean" },
    "artifactIds": {
      "type": "array",
      "items": {
        "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "output": { "type": ["string", "null"], "maxLength": 8388608 },
    "failure": { "type": ["string", "null"], "maxLength": 2000 }
  },
  "allOf": [
    {
      "if": { "properties": { "completed": { "const": true } }, "required": ["completed"] },
      "then": {
        "properties": {
          "state": { "const": "completed" },
          "terminal": { "const": true },
          "artifactIds": { "type": "array", "minItems": 1 },
          "failure": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": {
        "properties": {
          "terminal": { "const": true },
          "completed": { "const": false },
          "failure": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
