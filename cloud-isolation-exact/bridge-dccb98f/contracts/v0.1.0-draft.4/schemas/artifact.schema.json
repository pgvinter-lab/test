{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/artifact.schema.json",
  "title": "Bridge 2.0 Draft Artifact and Citation Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "projectId",
    "kind",
    "createdAt",
    "createdBy",
    "sensitivity",
    "content",
    "locations",
    "provenance",
    "citations"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-draft.4" },
    "artifactId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "projectId": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "source",
        "source_code",
        "prompt",
        "response",
        "review",
        "decision",
        "report",
        "attachment",
        "backup"
      ]
    },
    "createdAt": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/timestamp"
    },
    "createdBy": {
      "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/principalRef"
    },
    "sensitivity": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "sizeBytes", "sha256"],
      "properties": {
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/sha256"
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["storageClass", "uri"],
        "properties": {
          "storageClass": {
            "enum": ["local", "drive_replica", "github_source", "remote_object"]
          },
          "uri": { "type": "string", "format": "uri-reference", "minLength": 1 },
          "encrypted": { "type": "boolean" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "parentArtifactIds", "captureMethod"],
      "properties": {
        "origin": {
          "enum": ["human", "agent", "adapter", "import", "derived", "system"]
        },
        "parentArtifactIds": {
          "type": "array",
          "items": {
            "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "captureMethod": { "type": "string", "minLength": 1, "maxLength": 300 },
        "adapterId": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
        },
        "tool": { "type": "string", "minLength": 1, "maxLength": 300 },
        "model": { "type": "string", "minLength": 1, "maxLength": 300 },
        "transform": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "enum": ["project", "temporary", "legal_hold", "owner_defined"] },
        "expiresAt": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/timestamp"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sensitivity": { "enum": ["confidential", "restricted"] }
        }
      },
      "then": {
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "storageClass": { "const": "github_source" }
                    },
                    "required": ["storageClass"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "storageClass": {
                        "enum": ["drive_replica", "remote_object"]
                      }
                    },
                    "required": ["storageClass"]
                  },
                  "then": {
                    "properties": { "encrypted": { "const": true } },
                    "required": ["encrypted"]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "enum": ["response", "review", "decision", "report"] }
        }
      },
      "then": {
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "not": {
                "properties": {
                  "storageClass": { "const": "github_source" }
                },
                "required": ["storageClass"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locations": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "storageClass": { "const": "github_source" } },
              "required": ["storageClass"]
            }
          }
        },
        "required": ["locations"]
      },
      "then": {
        "properties": {
          "kind": { "const": "source_code" },
          "sensitivity": { "enum": ["public", "internal"] }
        }
      }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citationId",
        "sourceArtifactId",
        "locator",
        "claim",
        "verification"
      ],
      "properties": {
        "citationId": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
        },
        "sourceArtifactId": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/identifier"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["line", "page", "section", "timestamp", "uri", "record"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "claim": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "quoteHash": {
          "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/sha256"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method"],
          "properties": {
            "status": { "enum": ["unverified", "verified", "contradicted", "inconclusive"] },
            "method": { "type": "string", "minLength": 1, "maxLength": 300 },
            "verifiedBy": {
              "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/principalRef"
            },
            "verifiedAt": {
              "$ref": "https://bridge2.local/contracts/v0.1.0-draft.4/schemas/common.schema.json#/$defs/timestamp"
            }
          }
        }
      }
    }
  }
}
