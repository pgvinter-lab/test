{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/contracts/mailbox-v1-draft/v3/schemas/config.schema.json",
  "title": "Bridge Mailbox v3 Local Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stateDirectory", "databasePath", "auditMirrorPath", "exchangeRoot", "broker", "providers", "webNodes", "delivery", "integrations"],
  "properties": {
    "schemaVersion": { "const": "bridge-mailbox-config-v3" },
    "stateDirectory": { "type": "string", "minLength": 3 },
    "databasePath": { "type": "string", "minLength": 3 },
    "auditMirrorPath": { "type": "string", "minLength": 3 },
    "exchangeRoot": { "type": "string", "minLength": 3 },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "tokenFile", "allowedOrigins"],
      "properties": {
        "host": { "enum": ["127.0.0.1", "::1"] },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "tokenFile": { "type": "string", "minLength": 3 },
        "allowedOrigins": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chatgpt", "antigravity", "web"],
      "properties": {
        "chatgpt": { "$ref": "#/$defs/providerConfig" },
        "antigravity": { "$ref": "#/$defs/providerConfig" },
        "web": { "$ref": "#/$defs/providerConfig" }
      }
    },
    "webNodes": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/webNodeId" },
      "additionalProperties": { "$ref": "web-node.schema.json" }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseMs", "heartbeatExtensionMs", "pollIntervalMs", "defaultExpiryMs", "maxPreDispatchAttempts"],
      "properties": {
        "leaseMs": { "type": "integer", "minimum": 30000 },
        "heartbeatExtensionMs": { "type": "integer", "minimum": 30000 },
        "pollIntervalMs": { "type": "integer", "minimum": 1000 },
        "defaultExpiryMs": { "type": "integer", "minimum": 30000 },
        "maxPreDispatchAttempts": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chromeExtensionDirectory", "antigravityPluginDirectory", "webBrowserProfileDirectory"],
      "properties": {
        "chromeExtensionDirectory": { "type": "string", "minLength": 3 },
        "antigravityPluginDirectory": { "type": "string", "minLength": 3 },
        "webBrowserProfileDirectory": { "type": "string", "minLength": 3 }
      }
    }
  },
  "$defs": {
    "providerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "consumerId"],
      "properties": {
        "enabled": { "type": "boolean" },
        "consumerId": { "$ref": "common.schema.json#/$defs/identifier" }
      }
    }
  }
}
