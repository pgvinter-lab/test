{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/contracts/mailbox-v1-draft/v3/schemas/web-node.schema.json",
  "title": "Bridge WEB Node Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nodeId", "displayName", "enabled", "origin", "startUrl", "auth", "selectors", "behavior"],
  "properties": {
    "schemaVersion": { "const": "bridge-web-node-v1" },
    "nodeId": { "$ref": "common.schema.json#/$defs/webNodeId" },
    "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
    "enabled": { "type": "boolean" },
    "origin": { "type": "string", "format": "uri", "pattern": "^https://[^/]+$" },
    "startUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "const": "browser-profile" },
        "signInHint": { "type": "string", "maxLength": 240 }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composer", "submit", "response", "busy"],
      "properties": {
        "composer": { "$ref": "#/$defs/requiredSelectors" },
        "submit": { "$ref": "#/$defs/selectors" },
        "response": { "$ref": "#/$defs/requiredSelectors" },
        "busy": { "$ref": "#/$defs/selectors" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submitMode", "responseMode", "timeoutMs", "settleMs", "stablePolls", "maxBytes"],
      "properties": {
        "submitMode": { "enum": ["button-or-enter", "button-only", "enter-only"] },
        "responseMode": { "const": "last-new-node" },
        "timeoutMs": { "type": "integer", "minimum": 30000, "maximum": 1800000 },
        "settleMs": { "type": "integer", "minimum": 250, "maximum": 10000 },
        "stablePolls": { "type": "integer", "minimum": 2, "maximum": 30 },
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "selectors": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/selector" }
    },
    "requiredSelectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/selector" }
    }
  }
}
